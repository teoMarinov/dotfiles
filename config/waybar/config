{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 2,
    "margin-left": 4,
    "margin-right": 4,
    "spacing": 0,

    // ── Auto-hide (see hypr/scripts/WaybarAutoHide.sh) ─────────────
    "start_hidden": true,
    "on-sigusr1": "show",
    "on-sigusr2": "hide",

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock",
    ],

    "modules-right": [
        "pulseaudio",
        "backlight",
        "temperature",
        "cpu",
        "memory",
        "tray",
        "hyprland/language",
    ],

    // ── Workspaces ──────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    // ── Clock ────────────────────────────────────────────────────
    "clock": {
        "format": "{:%H:%M %a, %b %d}",
        "locale": "en_GB.UTF-8",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "",
            "on-scroll": 0,
            "format": {
                "months":     "<span color='#cdd6f4'><b>{}</b></span>",
                "days":       "<span color='#cdd6f4'>{}</span>",
                "weekdays":   "<span color='#fdd66f'><b>{}</b></span>",
                "today":      "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
       "actions": {
         "on-scroll-down": "shift_up",
         "on-scroll-up": "shift_down",
         "on-click-middle": "shift_reset",
         "on-click-right": "mode",
  },
    },

     "temperature": {
          "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
          "critical-threshold": 90,
          "format": "󰔏 {temperatureC}°C",
          "format-critical": "󰸁 {temperatureC}°C"
     },

    "cpu": {
       "interval": 2,
       "format": "󰻠 {usage}%",
       "tooltip-format": "{avg_frequency} GHz"
    },

    "memory": {
        "interval": 1,
        "format": "󰍛 {percentage}%",
      },

    "hyprland/language": {
        "format": "󰌌 {short}"
     },

    "battery": {
        "states": {
            "warning": 50,
            "critical": 30
        },
        "format": "{icon}",
        "format-charging": "󱐋",
        "format-full": "",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "backlight": {
           "device": "amdgpu_bl2",
           "format": "{icon} {percent}%",
           "format-icons": ["󰃞", "󰃟", "󰃠"],
           "on-scroll-up": "brightnessctl -d amdgpu_bl2 -e4 -n2 set 5%+",
           "on-scroll-down": "brightnessctl -d amdgpu_bl2 -e4 -n2 set 5%-",
           "tooltip": false
      },

    // ── Media (MPRIS) ────────────────────────────────────────────
    "mpris": {
        "format": "<span size='large'>{player_icon}</span> {title}",
        "format-paused": "<span size='large'>{status_icon}</span> {title}",
        "player-icons": {
            "default": "󰏤",
            "spotify": "󰓇"
        },
        "status-icons": {
            "paused": "󰐊"
        },
        "max-length": 30,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player} — {title} by {artist}"
    },

    // ── Audio ────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
        "tooltip": false
    },

    "group": {
        "orientation": "horizontal",
        "modules": ["temperature", "cpu", "memory"],
        "on-click": "kitty btop"
      },

    // ── System Tray ──────────────────────────────────────────────
    "tray": {
        "icon-size": 14,
        "spacing": 10,
        "show-passive-items": false
    },

    // ── Notifications (requires swaync) ──────────────────────────
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // ── Power ────────────────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "$HOME/.config/hypr/scripts/PowerMenu.sh"
    }
}
