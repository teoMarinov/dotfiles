/* Alt-Tab style window switcher (scripts/window-switcher.sh).
 * Window width, columns and lines are set by the script from the window count.
 * If you change the card size, update card_width in the script to match:
 * element-icon size + 2 * element padding + listview spacing. */
@import "config.rasi"

window {
    location:                    center;
    anchor:                      center;
    border-radius:               12px;
}

inputbar {
    enabled:                     false;
}

listview {
    flow:                        horizontal;
    fixed-columns:               true;
    dynamic:                     true;
    spacing:                     10px;
}

element {
    orientation:                 vertical;
    padding:                     10px;
    spacing:                     8px;
    border-radius:               8px;
}

element-icon {
    size:                        260px;
    background-color:            transparent;
}

element-text {
    horizontal-align:            0.5;
    background-color:            transparent;
}
